{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/projects/(ar-interactive-scene|vr-abandoned-mine-scene)/?$",
      "status": 308,
      "headers": { "Location": "/projects" }
    },
    { "handle": "filesystem" },
    { "src": "^/(projects|about|contact)/?$", "dest": "/$1/index.html" },
    {
      "src": "^/projects/(deinosavros|procedural-city|rhythm-rider|ink-vfx|one-more-second|oasis-environment|single-vfx-studies|factory-environment|low-poly-sakura-scene|realistic-corner)/?$",
      "dest": "/projects/$1/index.html"
    },
    { "src": "/.*", "dest": "/404.html", "status": 404 }
  ]
}
